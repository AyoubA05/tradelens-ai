# TradeLens AI — secrets template
# Copy this file to `.streamlit/secrets.toml` (or paste into the Streamlit
# Community Cloud "Secrets" box) and fill in real values.
# `.streamlit/secrets.toml` is gitignored and must NEVER be committed.
#
# IMPORTANT — keys must be TOP-LEVEL (no [section] headers). Streamlit only
# exports top-level scalar secrets to environment variables, and the app reads
# st.secrets["ANTHROPIC_API_KEY"] (config.py) and the DEMO_MODE env var. Nesting
# these under a section would silently disable both.

# Public demo runs on cached/mock AI output and makes ZERO real API calls.
# Set to "false" only if you supply your own ANTHROPIC_API_KEY below.
DEMO_MODE = "true"

# Your Anthropic API key — used only when DEMO_MODE = "false".
# Get one at https://console.anthropic.com/  (leave the placeholder for a
# demo-only deployment).
ANTHROPIC_API_KEY = "sk-ant-YOUR-KEY-HERE"
