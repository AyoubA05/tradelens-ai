# Copy this file to .env and fill in your values
OPENAI_API_KEY=

# Database
DATABASE_URL=sqlite:///./data/tradelens.db

# AI model selection (override to swap models without touching code)
MODEL_VISION=gpt-4o
MODEL_TEXT=gpt-4o-mini

# OpenAI client tuning
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

ENV=development
