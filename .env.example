# Copy this file to .env and fill in your values

# Legacy Streamlit login credentials, retained for emergency regression access.
# They are ignored unless ENABLE_LEGACY_STREAMLIT_AUTH=true. Once DB users exist
# (created via signup), the secrets login is no longer used even when enabled.
TRADELENS_USERNAME=demo
TRADELENS_PASSWORD=tradelens2025

# Emergency compatibility only. Production defaults to website-hosted auth;
# set true explicitly to restore the legacy Streamlit login form.
ENABLE_LEGACY_STREAMLIT_AUTH=false

# Invite code that gates account signup. Leave unset to HIDE the signup form.
TRADELENS_INVITE_CODE=your-invite-code-here

# AI screenshot analysis (this app uses Anthropic)
ANTHROPIC_API_KEY=

# Database — local dev defaults to SQLite. For Postgres (Neon), paste your
# connection string (keep sslmode=require). Never commit a real password.
DATABASE_URL=sqlite:///./data/tradelens.db
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# AI model: every feature runs on Claude Opus 5. The model ID is fixed in
# src/tradelens/config.py (ANTHROPIC_MODEL_ID) and is intentionally not
# overridable here — there is no per-feature routing and no model fallback.
EFFORT_DEFAULT=medium

# Anthropic client tuning
ANTHROPIC_TIMEOUT=120
ANTHROPIC_MAX_RETRIES=2

# DEMO_MODE=true returns cached/mock AI output — zero API spend (used in tests)
DEMO_MODE=false

ENV=development
