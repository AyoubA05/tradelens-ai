          "day_of_week",
          "session",
          "asset",
          "asset_class",
          "timeframe",
          "direction",
          "bias",
          "setup_type",
          "entry_price",
          "stop_price",
          "tp_price",
          "exit_price",
          "position_size",
          "risk_amount",
          "reward_amount",
          "rr_planned",
          "rr_realized",
          "result",
          "pnl",
          "strategy_used",
          "emotions_before",
          "emotions_during",
          "emotions_after",
          "notes",
          "trade_process_notes",
          "ai_grade",
          "user_grade",
          "htf_bias",
          "killzone",
          "liquidity_sweep",
          "fvg_used",
          "order_block_used",
          "bos",
          "choch",
          "confirmation_model",
          "entry_type",
          "mistake_tags",
          "followed_rules",
          "created_at",
          "updated_at",
          "screenshots"
        ],
        "title": "TradeDetail",
        "type": "object"
      },
      "TradeListResponse": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          },
          "trades": {
            "items": {
              "$ref": "#/components/schemas/TradeSummary"
            },
            "title": "Trades",
            "type": "array"
          }
        },
        "required": [
          "trades",
          "total",
          "limit",
          "offset"
        ],
        "title": "TradeListResponse",
        "type": "object"
      },
      "TradeSummary": {
        "additionalProperties": false,
        "description": "One row of the Trades list \u2014 deliberately narrower than TradeDetail.\n\nThe list view does not need every SMC/ICT annotation field; Trade Detail\n(below) is where the full record lives.",
        "properties": {
          "asset": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset"
          },
          "direction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "killzone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Killzone"
          },
          "pnl": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pnl"
          },
          "result": {
            "anyOf": [
              {
                "enum": [
                  "Win",
                  "Loss",
                  "Breakeven"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "rr_realized": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rr Realized"
          },
          "session": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session"
          },
          "setup_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Setup Type"
          },
          "trade_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trade Date"
          }
        },
        "required": [
          "id",
          "trade_date",
          "asset",
          "direction",
          "session",
          "setup_type",
          "killzone",
          "result",
          "pnl",
          "rr_realized"
        ],
        "title": "TradeSummary",
        "type": "object"
      },
      "Trajectory": {
        "additionalProperties": false,
        "properties": {
          "average_loss": {
            "$ref": "#/components/schemas/Undefinable"
          },
          "average_win": {
            "$ref": "#/components/schemas/Undefinable"
          },
          "best_streak": {
            "title": "Best Streak",
            "type": "integer"
          },
          "current_streak": {
            "title": "Current Streak",
            "type": "integer"
          },
          "equity_curve": {
            "items": {
              "$ref": "#/components/schemas/EquityPoint"
            },
            "title": "Equity Curve",
            "type": "array"
          },
          "streak_type": {
            "enum": [
              "win",
              "loss",
              "none"
            ],
            "title": "Streak Type",
            "type": "string"
          },
          "worst_streak": {
            "title": "Worst Streak",
            "type": "integer"
          }
        },
        "required": [
          "equity_curve",
          "current_streak",
          "streak_type",
          "best_streak",
          "worst_streak",
          "average_win",
          "average_loss"
        ],
        "title": "Trajectory",
        "type": "object"
      },
      "Undefinable": {
        "additionalProperties": false,
        "description": "A possibly-undefined number as {value, state}.\n\nBoth fields are required (no `= None` default) even though both are\n`Optional` in type: `_pair`/`_sample_pair` on the service side always emit\nboth keys together, so a payload with one missing is a shape change to\ncatch here, not a plain absence to paper over with a default null.",
        "properties": {
          "state": {
            "anyOf": [
              {
                "enum": [
                  "undefined_nan",
                  "undefined_positive_infinity",
                  "undefined_negative_infinity",
                  "undefined_no_sample",
                  "undefined_incomplete_sample"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "value",
          "state"
        ],
        "title": "Undefinable",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WhoAmI": {
        "properties": {
          "user_id": {
            "title": "User Id",
            "type": "integer"
          }
        },
        "required": [
          "user_id"
        ],
        "title": "WhoAmI",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "TradeLens API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness only. Reveals nothing about configuration, data, or version.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/overview": {
      "get": {
        "description": "Everything the Overview screen shows, for the authenticated owner.\n\nThe owner is the session row's. Nothing in the query, the headers, or the\nbody can name a different account.",
        "operationId": "get_overview_v1_overview_get",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "title": "From",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "title": "To",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Overview",
        "tags": [
          "overview"
        ]
      }
    },
    "/v1/session/whoami": {
      "get": {
        "description": "Echo the authenticated owner.\n\nExists to prove both locks end to end. The value returned is the one the\nsession row resolved to, never anything the caller supplied.",
        "operationId": "whoami_v1_session_whoami_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoAmI"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Whoami",
        "tags": [
          "session"
        ]
      }
    },
    "/v1/trades": {
      "get": {
        "description": "The Trades list for the authenticated owner.\n\nThe owner is the session row's, never the query. `limit`/`offset` are\nclamped inside `list_trades` itself, so a caller requesting `limit=1000`\ngets 100 back rather than a 422 \u2014 the service is the one source of truth\nfor the bound, matching `list_trades`'s own contract.",
        "operationId": "get_trades_list_v1_trades_get",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "title": "From",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "title": "To",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "asset",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Asset"
            }
          },
          {
            "in": "query",
            "name": "session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session"
            }
          },
          {
            "in": "query",
            "name": "setup",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Setup"
            }
          },
          {
            "in": "query",
            "name": "result",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Result"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TradeListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Trades List",
        "tags": [
          "trades"
        ]
      }
    },
    "/v1/trades/{trade_id}": {
      "get": {
        "description": "One trade, plus presigned URLs for its screenshots.\n\n`get_trade` already filters on `Trade.user_id == owner`, so a trade\nbelonging to another account is indistinguishable from a nonexistent one\nat the ORM layer \u2014 this handler preserves that by raising the identical\n404 either way, never a 403.",
        "operationId": "get_trade_detail_v1_trades__trade_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "trade_id",
            "required": true,
            "schema": {
              "title": "Trade Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TradeDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Trade Detail",
        "tags": [
          "trades"
        ]
      }
    }
  }
}
