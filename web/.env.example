# TradeLens web — development environment.
#
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# NOTHING here is NEXT_PUBLIC_*. Every value below is server-only: a database
# URL, session secret, invite code or SMTP password in a NEXT_PUBLIC_ variable
# is inlined into the JavaScript bundle and served to every visitor. Values
# that are genuinely safe for the browser (the origins) are passed down from
# server components as explicit props instead, so exposing one is always a
# visible decision.

# --- database -------------------------------------------------------------
# DEVELOPMENT MUST POINT AT dev-auth-migration / neondb.
# Never point local development at production.
# Alembic owns this schema; the web app only reads and writes it.
DATABASE_URL=

# --- origins --------------------------------------------------------------
# Where the Streamlit journal lives. Never hardcode the hostname anywhere.
APP_ORIGIN=http://localhost:8501
# Where this site lives. Used for same-origin CSRF checks and redirect allowlists.
SITE_ORIGIN=http://localhost:3000

# --- signup gating --------------------------------------------------------
# invite | open | closed. Unset defaults to invite.
# An unrecognised value is treated as closed: access control must fail shut.
SIGNUP_MODE=invite
TRADELENS_INVITE_CODE=

# --- session signing ------------------------------------------------------
# Must be byte-identical to the value in Streamlit Cloud secrets, or tokens
# issued here are rejected there. Generate with: openssl rand -base64 48
TRADELENS_SESSION_SECRET=

# --- email ----------------------------------------------------------------
# Same variable names the Python side uses, so one configuration describes both
# runtimes. When unset, verification and reset report that nothing was sent —
# they never claim delivery that did not happen.
TRADELENS_SMTP_HOST=
TRADELENS_SMTP_PORT=587
TRADELENS_SMTP_USER=
TRADELENS_SMTP_PASSWORD=
TRADELENS_SMTP_FROM=
