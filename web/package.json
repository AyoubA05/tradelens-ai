{
  "name": "tradelens-web",
  "version": "0.1.0",
  "private": true,
  "description": "Site-hosted authentication for TradeLens AI. The marketing site lives in ../site and is copied into public/ at build time — it is not rewritten here.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prebuild": "node scripts/build-marketing.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:types": "openapi-typescript lib/api/openapi.json -o lib/api/schema.d.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.3",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "0.474.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.5",
    "pg": "8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "jsdom": "26.0.0",
    "openapi-typescript": "^7.9.1",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  }
}
